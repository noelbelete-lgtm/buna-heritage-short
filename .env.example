# Copy to .env (git-ignored) and fill in. Never commit .env.
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
CLOUDFLARE_ACCOUNT_ID=     # dash.cloudflare.com -> Workers AI -> "Use REST API"
CLOUDFLARE_API_TOKEN=      # token with Workers AI read/edit permission

# Optional overrides when a model id changes (check the model list in AI Studio)
# GEMINI_TTS_MODEL=gemini-3.8-flash-preview-tts
# GEMINI_TEXT_MODEL=gemini-3.8-flash-lite
