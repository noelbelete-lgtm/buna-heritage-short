    "path": "outputs/narration/s05_e4c5223039.wav",
    "duration_s": 5.539,
    "text": "የመጀመሪያው ስኒ አቦል ይባላል። ጠንካራ ነው፣ እንደ ጅማሬ።",
    "trimmed_s": 2.93
  },
  "s06": {
    "key": "acdd77f5ae21d7f09507af774617e624b27690fc3d3eff7ebca6fe243abf29ee",
    "path": "outputs/narration/s06_acdd77f5ae.wav",
    "duration_s": 5.516,
    "text": "ፈንዲሻ ይቀርባል፣ ዕጣን ይጨሳል። ጨዋታው ይጀምራል።",
    "trimmed_s": 2.61
  },
  "s07": {
    "key": "3c6aa052cb96c97a804e22fbc98f20d8ab67372d7b9675c7ab07fcd11b5af133",
    "path": "outputs/narration/s07_3c6aa052cb.wav",
    "duration_s": 4.074,
    "text": "ሁለተኛው ቶና ነው። ቀለል ይላል፤ ጨዋታውም ይሞቃል።",
    "trimmed_s": 2.43
  },
  "s08": {
