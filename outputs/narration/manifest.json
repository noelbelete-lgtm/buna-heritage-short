  },
  "s04": {
    "key": "4c2136eaaa312e8b6758309184055dc49aedc95ac588137e9c7f2f23846e3be3",
    "path": "outputs/narration/s04_4c2136eaaa.wav",
    "duration_s": 4.617,
    "text": "የቡናው ጭስ ለሁሉም ይዞራል። ማንም አይቀርም።",
    "trimmed_s": 2.83
  },
  "s05": {
