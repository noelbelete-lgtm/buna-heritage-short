    "path": "outputs/narration/s08_1e97dd2f09.wav",
    "duration_s": 6.147,
    "text": "እዚህ ዜና ይሰማል፣ የተጣሉ ይታረቃሉ፣ ሳቅ ይካፈላል።",
    "trimmed_s": 2.85
  },
  "s10": {
    "key": "dbdb9056a1325170797b0e68758f6ff5843041792679d51556566b8b3f6d16fc",
    "path": "outputs/narration/s10_dbdb9056a1.wav",
    "duration_s": 3.835,
    "text": "ቡና መጠጥ ብቻ አይደለም። አብሮ የመሆን ጊዜ ነው።",
    "trimmed_s": 2.62
  },
  "s01": {
