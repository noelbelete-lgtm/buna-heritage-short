    "path": "outputs/narration/s01_8cb645b926.wav",
    "duration_s": 4.707,
    "text": "በየቀኑ ከሰዓት በኋላ፣ በቤታችን አንድ ሥርዓት ይጀምራል።",
    "trimmed_s": 2.82
