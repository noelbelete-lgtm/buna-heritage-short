{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heritage Short storyboard",
  "description": "The contract between every pipeline stage. Each stage reads this file and nothing else for its inputs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "film", "models", "style_block", "references", "shots", "music"],
  "$defs": {
    "nonEmpty": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "shotId": {"type": "string", "pattern": "^s[0-9]{2}$"},
    "modelRef": {
      "type": "object",
      "required": ["provider", "model"],
      "properties": {"provider": {"type": "string"}, "model": {"type": "string"}}
    }
  },
  "properties": {
    "schema_version": {"const": "1.0"},
    "film": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "logline", "narration_language", "subtitle_language", "target_duration_s", "fps", "end_card"],
      "properties": {
        "title": {"$ref": "#/$defs/nonEmpty"},
        "title_am": {"type": "string"},
        "logline": {"$ref": "#/$defs/nonEmpty"},
        "narration_language": {"type": "string", "minLength": 2, "maxLength": 5},
        "subtitle_language": {"type": "string", "minLength": 2, "maxLength": 5},
        "target_duration_s": {"type": "array", "items": {"type": "number", "minimum": 1}, "minItems": 2, "maxItems": 2},
        "fps": {"type": "integer", "enum": [24, 25, 30]},
        "end_card": {
          "type": "object",
          "required": ["duration_s", "lines"],
          "properties": {
            "duration_s": {"type": "number", "minimum": 2, "maximum": 6},
            "lines": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "required": ["text", "size"],
                "properties": {"text": {"$ref": "#/$defs/nonEmpty"}, "size": {"enum": ["large", "medium", "small"]}}
              },
              "contains": {"type": "object", "properties": {"text": {"pattern": "[Mm]ade with AI"}}}
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "required": ["keyframes", "tts", "video", "music"],
      "properties": {
        "keyframes": {"allOf": [{"$ref": "#/$defs/modelRef"}, {"required": ["steps"], "properties": {"steps": {"type": "integer", "minimum": 1, "maximum": 50}}}]},
        "tts": {"allOf": [{"$ref": "#/$defs/modelRef"}, {"required": ["voice", "style"]}]},
        "video": {"allOf": [{"$ref": "#/$defs/modelRef"}, {"required": ["width", "height", "num_frames", "steps", "guidance"],
          "properties": {
            "width": {"type": "integer", "multipleOf": 32}, "height": {"type": "integer", "multipleOf": 32},
            "num_frames": {"type": "integer", "minimum": 5}, "steps": {"type": "integer", "minimum": 1}, "guidance": {"type": "number"}
          }}]},
        "music": {"$ref": "#/$defs/modelRef"}
      }
    },
    "style_block": {"type": "string", "minLength": 10},
    "negative_prompt": {"type": "string"},
    "references": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description", "sheet_prompt"],
        "properties": {
          "description": {"$ref": "#/$defs/nonEmpty"},
          "sheet_prompt": {"$ref": "#/$defs/nonEmpty"},
          "approved_seed": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/seed"}]}
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "beat", "reason", "shot_size", "duration_s", "refs", "keyframe", "motion", "narration", "music_cue"],
        "properties": {
          "id": {"$ref": "#/$defs/shotId"},
          "beat": {"$ref": "#/$defs/nonEmpty"},
          "reason": {"type": "string", "minLength": 15},
          "shot_size": {"enum": ["extreme_wide", "wide", "medium_wide", "medium", "medium_close_up", "close_up", "extreme_close_up", "insert"]},
          "duration_s": {"type": "number", "minimum": 3, "maximum": 12},
          "refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "keyframe": {
            "type": "object", "additionalProperties": false, "required": ["prompt", "seed"],
            "properties": {"prompt": {"type": "string", "minLength": 10, "maxLength": 1200}, "seed": {"$ref": "#/$defs/seed"}}
          },
          "motion": {
            "type": "object", "additionalProperties": false, "required": ["method", "prompt", "camera", "seed"],
            "properties": {
              "method": {"enum": ["i2v", "kenburns"]},
              "prompt": {"$ref": "#/$defs/nonEmpty"},
              "camera": {"enum": ["push_in", "pull_back", "pan_left", "pan_right", "tilt_up", "tilt_down", "fixed"]},
              "seed": {"$ref": "#/$defs/seed"}
            }
          },
          "narration": {
            "type": "object", "additionalProperties": false, "required": ["am", "en"],
            "properties": {"am": {"$ref": "#/$defs/nonEmpty"}, "en": {"$ref": "#/$defs/nonEmpty"}}
          },
          "on_screen_text": {
            "oneOf": [
              {"type": "null"},
              {"type": "object", "required": ["en"], "properties": {"en": {"$ref": "#/$defs/nonEmpty"}, "am": {"type": "string"}}}
            ]
          },
          "music_cue": {"type": "string"}
        }
      }
    },
    "music": {
      "type": "object",
      "required": ["caption", "instrumental", "bpm", "duration_s", "seeds", "selected", "cues"],
      "properties": {
        "caption": {"type": "string", "minLength": 10},
        "lyrics": {"type": ["string", "null"]},
        "instrumental": {"type": "boolean"},
        "bpm": {"type": "integer", "minimum": 40, "maximum": 200},
        "key": {"type": ["string", "null"]},
        "duration_s": {"type": "number", "minimum": 30, "maximum": 240},
        "seeds": {"type": "array", "items": {"$ref": "#/$defs/seed"}, "minItems": 1, "maxItems": 8},
        "selected": {"type": ["string", "null"]},
        "selection_reason": {"type": ["string", "null"]},
        "cues": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "required": ["id", "shots", "note"],
            "properties": {"id": {"type": "string"}, "shots": {"type": "array", "items": {"$ref": "#/$defs/shotId"}}, "note": {"type": "string"}}
          }
        }
      }
    }
  }
}
